# Copia este archivo a un archivo local de variables (no se versiona) y completa los valores.
# En Render se configuran en Environment del servicio de la API.
PORT=3000
# Cadena de conexión de MongoDB Atlas (sin credenciales reales en este archivo)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/entregable3?retryWrites=true&w=majority
# Orígenes permitidos por CORS, separados por coma (en producción, la URL del frontend en Render)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
